      "duplicate rows       : 0\n",
      "time steps (seconds) : {np.int64(300)}\n",
      "readings per VM      : {134}\n"
     ]
    }
   ],
   "source": [
    "gaps = np.diff(all_times)\n",
    "\n",
    "print(\"missing values       :\", cpu.isna().sum().sum())\n",
    "print(\"duplicate rows       :\", cpu.duplicated([\"vm_id\", \"timestamp\"]).sum())\n",
